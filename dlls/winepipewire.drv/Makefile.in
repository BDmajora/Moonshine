MODULE    = winepipewire.drv
UNIXLIB   = winepipewire.so
IMPORTS   = dxguid uuid winmm user32 advapi32 ole32

# SPA/PipeWire headers live in versioned dirs (media-libs/pipewire):
#   /usr/include/pipewire-0.3/pipewire/...
#   /usr/include/spa-0.2/spa/...
# Pass them as LITERAL -I so the flags survive makedep regardless of whether
# configure ever defined PIPEWIRE_CFLAGS, and link the runtime lib directly.
# (This is exactly what `pkg-config --cflags --libs libpipewire-0.3` emits.)
UNIX_CFLAGS  = -D_REENTRANT -I/usr/include/pipewire-0.3 -I/usr/include/spa-0.2
UNIX_LIBS    = -lpipewire-0.3 $(PTHREAD_LIBS) -lm

SOURCES = \
	pipewire.c