#include <windows.h>
#include "desktop_defs.h"

/* Version Information */
VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "YetiOS Desktop"
            VALUE "FileVersion",      "1.0"
            VALUE "InternalName",     "desktop"
            VALUE "OriginalFilename", "desktop.exe"
            VALUE "ProductName",      "YetiOS"
            VALUE "ProductVersion",   "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4b0
    END
END
