#include <windows.h>
#include <commctrl.h>
#include "calc_defs.h"

/* Icon */
IDI_APPLICATION ICON "calc.ico"

/* Version Information */
VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Moonshine Calculator"
            VALUE "FileVersion",      "1.0"
            VALUE "InternalName",     "calc"
            VALUE "OriginalFilename", "calc.exe"
            VALUE "ProductName",      "Moonshine"
            VALUE "ProductVersion",   "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4b0
    END
END

/* About dialog */
IDD_ABOUT DIALOGEX 0, 0, 250, 180
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Calculator"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON          IDI_APPLICATION, IDC_STATIC, 10, 10, 21, 20
    LTEXT         "Calculator", IDC_STATIC, 40, 10, 100, 8
    LTEXT         "Developed for Wine by BDmajora", IDC_STATIC, 40, 22, 200, 8
    LTEXT         "Running on wine-11.0", IDC_STATIC, 40, 34, 200, 8
    CONTROL       "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 10, 50, 230, 1
    LTEXT         "Wine was brought to you by:", IDC_STATIC, 10, 60, 200, 8
    LISTBOX       IDC_ABOUT_AUTHORS, 10, 72, 160, 90, LBS_NOSEL | WS_VSCROLL | WS_BORDER
    PUSHBUTTON    "Wine &licence", IDC_ABOUT_LICENSE, 180, 135, 60, 14
    DEFPUSHBUTTON "OK", IDOK, 180, 155, 60, 14
END