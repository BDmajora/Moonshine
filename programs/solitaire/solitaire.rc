#include <windows.h>
#include <commctrl.h>
#include "solitaire.h"

/* Use the ID from the header */
IDI_SOLITAIRE ICON "solitaire.ico"

IDR_MAINMENU MENU
BEGIN
    POPUP "&Game"
    BEGIN
        MENUITEM "&Deal\tF2",      IDM_GAME_DEAL
        MENUITEM SEPARATOR
        MENUITEM "E&xit",          IDM_GAME_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Solitaire", IDM_HELP_ABOUT
    END
END

/* Version Information */
VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Solitaire"
            VALUE "FileVersion",      "1.0"
            VALUE "InternalName",      "solitaire"
            VALUE "OriginalFilename", "solitaire.exe"
            VALUE "ProductName",      "Solitaire"
            VALUE "ProductVersion",   "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4b0
    END
END

/* The custom Wine-style About Dialog */
IDD_ABOUT DIALOGEX 0, 0, 250, 180
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Solitaire"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON          IDI_SOLITAIRE, IDC_STATIC, 10, 10, 21, 20
    LTEXT         "Solitaire", IDC_STATIC, 40, 10, 100, 8
    LTEXT         "Developed for Wine by BDMajora", IDC_STATIC, 40, 22, 200, 8
    LTEXT         "Running on wine-11.0", IDC_STATIC, 40, 34, 200, 8
    CONTROL       "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 10, 50, 230, 1
    LTEXT         "Wine was brought to you by:", IDC_STATIC, 10, 60, 200, 8
    LISTBOX       IDC_ABOUT_AUTHORS, 10, 72, 160, 90, LBS_NOSEL | WS_VSCROLL | WS_BORDER
    PUSHBUTTON    "Wine &licence", IDC_ABOUT_LICENSE, 180, 135, 60, 14
    DEFPUSHBUTTON "OK", IDOK, 180, 155, 60, 14
END

/* Blank line required below to avoid EOF warnings */