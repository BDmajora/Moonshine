#include <windows.h>
#include "solitaire.h"

/* Use the ID from the header */
IDI_SOLITAIRE ICON "solitaire.ico"

IDR_MAINMENU MENU
BEGIN
    POPUP "&Game"
    BEGIN
        MENUITEM "&Deal\tF2",      IDM_GAME_DEAL
        MENUITEM SEPARATOR
        MENUITEM "E&xit",          IDM_GAME_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents",      IDM_HELP_CONTENTS
        MENUITEM "&About Solitaire", IDM_HELP_ABOUT
    END
END

/* Version Information */
VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Solitaire"
            VALUE "FileVersion",      "1.0"
            VALUE "InternalName",      "solitaire"
            VALUE "OriginalFilename", "solitaire.exe"
            VALUE "ProductName",      "Solitaire"
            VALUE "ProductVersion",   "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4b0
    END
END
/* Ensure there is a blank line below this comment to avoid compiler EOF warnings */