MODULE        = solitaire.exe
IMPORTS       = cards user32 gdi32 advapi32 comctl32
EXTRADLLFLAGS = -mwindows -municode

# Link against the cards.dll headers
EXTRAINCL = -I$(top_srcdir)/dlls/cards

SOURCES = \
    solitaire.c \
    sol_cards.c \
    sol_game.c \
    sol_layout.c \
    sol_input.c \
    sol_draw.c \
    sol_endgame.c \
    sol_timer.c \
    sol_res.c \
    solitaire.rc